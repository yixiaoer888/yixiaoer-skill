{
  "title": "淘宝光合图文发布表单",
  "type": "object",
  "required": ["formType"],
  "properties": {
    "formType": {"type": "string", "const": "task"},
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["key", "size", "width", "height", "format"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 1},
          "width": {"type": "integer", "minimum": 720},
          "height": {"type": "integer", "minimum": 720},
          "format": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "title": {"type": "string", "maxLength": 30},
    "desc": {"type": "string", "maxLength": 1000},
    "tags": {"type": "array", "maxItems": 4, "items": {"type": "string"}},
    "statement": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "integer", "enum": [0, 1, 2, 4, 5, 6]},
        "forwardFrom": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "shopping_cart": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["yixiaoerId", "yixiaoerName", "raw"],
        "properties": {
          "yixiaoerId": {"type": "string", "minLength": 1},
          "yixiaoerName": {"type": "string", "minLength": 1},
          "yixiaoerImageUrl": {"type": "string"},
          "price": {"type": "number"},
          "yixiaoerDesc": {"type": "string"},
          "raw": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "scheduledTime": {"type": "integer", "minimum": 1000000000000, "maximum": 9999999999999}
  },
  "additionalProperties": false
}
