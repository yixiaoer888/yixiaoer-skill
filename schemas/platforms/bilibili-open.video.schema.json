{
  "title": "哔哩哔哩-Open视频发布表单 (Bilibili Open Video)",
  "type": "object",
  "required": [
    "contentPublishForm",
    "platformAccountId",
    "video",
    "cover",
    "coverKey"
  ],
  "properties": {
    "contentPublishForm": {
      "type": "object",
      "required": [
        "formType",
        "title",
        "tags",
        "category"
      ],
      "properties": {
        "formType": {
          "type": "string",
          "const": "task"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 0
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 20
          }
        },
        "category": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "yixiaoerId",
              "yixiaoerName",
              "raw"
            ],
            "properties": {
              "yixiaoerId": {
                "type": "string"
              },
              "yixiaoerName": {
                "type": "string"
              },
              "raw": {
                "type": "object"
              }
            }
          }
        },
        "allowReprint": {
          "type": "number",
          "enum": [
            0,
            1
          ],
          "default": 0
        },
        "createType": {
          "type": "number",
          "enum": [
            1,
            2
          ],
          "default": 1
        },
        "type": {
          "type": "number",
          "enum": [
            1,
            2
          ],
          "default": 1
        },
        "reprintSource": {
          "type": "string"
        },
        "visibleType": {
          "type": "number",
          "enum": [
            0,
            1
          ],
          "default": 0
        },
        "pubType": {
          "type": "number",
          "enum": [
            0,
            1
          ],
          "default": 1
        },
        "scheduledTime": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "video": {
      "type": "object",
      "required": [
        "key",
        "size",
        "width",
        "height",
        "duration"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "duration": {
          "type": "number",
          "minimum": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "mp4",
            "mov",
            "flv"
          ]
        }
      }
    },
    "cover": {
      "type": "object",
      "required": [
        "key",
        "size",
        "width",
        "height"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "format": {
          "type": "string"
        }
      }
    },
    "coverKey": {
      "type": "string"
    },
    "platformAccountId": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
