{
  "title": "新浪微博图文发布表单 (Xinlang Image-Text)",
  "type": "object",
  "required": [
    "formType",
    "description",
    "images",
    "visibleType",
    "declaration"
  ],
  "properties": {
    "formType": {
      "type": "string",
      "const": "task"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": [
          "key",
          "size",
          "width",
          "height"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "jpg",
              "jpeg",
              "png",
              "webp",
              "gif"
            ]
          }
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "yixiaoerId",
        "yixiaoerName",
        "raw"
      ],
      "properties": {
        "yixiaoerId": {
          "type": "string"
        },
        "yixiaoerName": {
          "type": "string"
        },
        "raw": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "scheduledTime": {
      "type": "number",
      "minimum": 0
    },
    "visibleType": {
      "type": "number",
      "enum": [
        0,
        1
      ],
      "default": 0
    },
    "declaration": {
      "type": "number",
      "enum": [
        0,
        1,
        2,
        3,
        4
      ],
      "default": 0
    }
  },
  "additionalProperties": false
}
