{
  "title": "百家号视频发布表单 (BaiJiaHao Video)",
  "type": "object",
  "required": [
    "formType",
    "description",
    "pubType"
  ],
  "properties": {
    "formType": {
      "type": "string",
      "const": "task"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pubType": {
      "type": "number",
      "enum": [
        0,
        1
      ],
      "default": 1
    },
    "statement": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "integer",
          "enum": [
            0,
            1,
            16,
            4,
            8,
            32
          ],
          "description": "声明：0-不声明，1-内容由AI生成，16-内容为转载，4-含虚构演绎内容，8-内容含有营销信息，32-个人观点，仅供参考。"
        },
        "subType": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            4,
            8
          ],
          "description": "补充声明：0-不选择，1-内容可能引人不适，2-内容含有高危险行为，4-请理性适度消费，8-未成年人请在监护人指导下浏览。"
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": [
        "id",
        "text",
        "raw"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "raw": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "collection": {
      "type": "object",
      "required": [
        "yixiaoerId",
        "yixiaoerName",
        "raw"
      ],
      "properties": {
        "yixiaoerId": {
          "type": "string"
        },
        "yixiaoerName": {
          "type": "string"
        },
        "raw": {
          "type": "object"
        }
      }
    },
    "activity": {
      "type": "object",
      "required": [
        "yixiaoerId",
        "yixiaoerName",
        "raw"
      ],
      "properties": {
        "yixiaoerId": {
          "type": "string"
        },
        "yixiaoerName": {
          "type": "string"
        },
        "raw": {
          "type": "object"
        }
      }
    },
    "video": {
      "type": "object",
      "required": [
        "key",
        "size",
        "width",
        "height"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "duration": {
          "type": "number",
          "minimum": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "mp4",
            "mov",
            "flv",
            "avi"
          ]
        }
      }
    },
    "cover": {
      "type": "object",
      "description": "百家号视频主封面（客户端内部作为横版/主封面使用）。",
      "required": [
        "key",
        "size",
        "width",
        "height"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    },
    "coverKey": {
      "type": "string"
    },
    "verticalCover": {
      "type": "object",
      "description": "百家号视频可选竖版封面；未提供时客户端使用主封面兜底。",
      "required": [
        "key",
        "size",
        "width",
        "height"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    },
    "scheduledTime": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
