{
  "title": "抖音图文发布表单 (Douyin Image-Text)",
  "type": "object",
  "required": [
    "formType",
    "title",
    "description",
    "images"
  ],
  "properties": {
    "formType": {
      "type": "string",
      "const": "task"
    },
    "title": {
      "type": "string",
      "maxLength": 20
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 10
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "key",
          "size",
          "width",
          "height"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "jpg",
              "jpeg",
              "png",
              "webp"
            ]
          }
        }
      }
    },
    "cover": {
      "type": "object",
      "required": [
        "key",
        "size",
        "width",
        "height"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    },
    "coverKey": {
      "type": "string"
    },
    "allowTake": {
      "type": "boolean",
      "default": true
    },
    "location": {
      "type": "object",
      "required": [
        "isScp",
        "data"
      ],
      "properties": {
        "isScp": {
          "type": "boolean"
        },
        "data": {
          "type": "object",
          "required": [
            "yixiaoerId",
            "yixiaoerName",
            "raw"
          ],
          "properties": {
            "yixiaoerId": {
              "type": "string"
            },
            "yixiaoerName": {
              "type": "string"
            },
            "raw": {
              "type": "object"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "music": {
      "type": "object",
      "required": [
        "yixiaoerId",
        "yixiaoerName",
        "raw"
      ],
      "properties": {
        "yixiaoerId": {
          "type": "string"
        },
        "yixiaoerName": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "playUrl": {
          "type": "string"
        },
        "raw": {
          "type": "object"
        }
      }
    },
    "challenge": {
      "type": "object",
      "required": [
        "yixiaoerId",
        "yixiaoerName",
        "raw"
      ],
      "properties": {
        "yixiaoerId": {
          "type": "string"
        },
        "yixiaoerName": {
          "type": "string"
        },
        "raw": {
          "type": "object"
        }
      }
    },
    "collection": {
      "type": "object",
      "required": [
        "yixiaoerId",
        "yixiaoerName",
        "raw"
      ],
      "properties": {
        "yixiaoerId": {
          "type": "string"
        },
        "yixiaoerName": {
          "type": "string"
        },
        "raw": {
          "type": "object"
        }
      }
    },
    "sub_collection": {
      "type": "object",
      "required": [
        "yixiaoerId",
        "yixiaoerName",
        "raw"
      ],
      "properties": {
        "yixiaoerId": {
          "type": "string"
        },
        "yixiaoerName": {
          "type": "string"
        },
        "raw": {
          "type": "object"
        }
      }
    },
    "scheduledTime": {
      "type": "number",
      "minimum": 0
    },
    "declaration": {
      "type": "number",
      "enum": [
        0,
        3,
        4,
        5,
        6
      ],
      "default": 0
    },
    "shopping_cart": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sale_title",
          "images",
          "data"
        ],
        "properties": {
          "sale_title": {
            "type": "string",
            "maxLength": 10
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "data": {
            "type": "object",
            "required": [
              "yixiaoerId",
              "yixiaoerName",
              "raw"
            ],
            "properties": {
              "yixiaoerId": {
                "type": "string"
              },
              "yixiaoerName": {
                "type": "string"
              },
              "raw": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "tagType": {
      "type": "string",
      "enum": [
        "位置",
        "团购",
        "购物车"
      ]
    }
  },
  "additionalProperties": false
}
